const $ = id => document.getElementById(id);
const setupView = $("setupView");
const quizView = $("quizView");
const resultView = $("resultView");
const wrongView = $("wrongView");

let questions = [];
let current = 0;
let correct = 0;
let answered = false;
let lastStart = "ます形";
let lastForms = [];
let lastCount = 10;

function renderFormOptions(){
  $("n5Options").innerHTML = FORM_GROUPS.N5.map(form => `
    <label class="option">
      <input type="checkbox" name="targetForm" value="${form}" checked>
      <span>${FORM_LABELS[form]}</span>
    </label>
  `).join("");

  $("n4Options").innerHTML = FORM_GROUPS.N4.map(form => `
    <label class="option">
      <input type="checkbox" name="targetForm" value="${form}" checked>
      <span>${FORM_LABELS[form]}</span>
    </label>
  `).join("");
}

function getSelectedForms(){
  return [...document.querySelectorAll('input[name="targetForm"]:checked')].map(el=>el.value);
}

function showOnly(view){
  [setupView,quizView,resultView,wrongView].forEach(v=>v.classList.add("hidden"));
  view.classList.remove("hidden");
  window.scrollTo({top:0,behavior:"instant"});
}

function shuffle(list){
  return list.slice().sort(() => Math.random() - .5);
}

function startQuiz(customQuestions=null){
  const start = document.querySelector('input[name="startForm"]:checked').value;
  const forms = customQuestions ? null : getSelectedForms();

  if(!customQuestions && !forms.length){
    alert("請至少選擇一個變化種類。");
    return;
  }

  if(customQuestions){
    questions = customQuestions.slice();
  }else{
    lastStart = start;
    lastForms = forms.slice();
    lastCount = Number(document.querySelector('input[name="questionCount"]:checked').value);

    questions = [];
    for(let i=0;i<lastCount;i++){
      const verb = VERBS[Math.floor(Math.random()*VERBS.length)];
      let target = forms[Math.floor(Math.random()*forms.length)];

      if(forms.length > 1 && target === start){
        target = forms.find(x => x !== start);
      }

      questions.push({verb,start,target});
    }
  }

  current = 0;
  correct = 0;
  answered = false;

  showOnly(quizView);
  renderQuestion();
}

function renderQuestion(){
  const q = questions[current];

  $("questionNo").textContent = `第 ${current+1} / ${questions.length} 題`;
  $("currentScore").textContent = `答對 ${correct} 題`;
  $("progressBar").style.width = `${(current / questions.length) * 100}%`;

  const startWord = q.verb.f[q.start] || q.verb.f["辞書形"] || q.verb.v;
  $("questionVerb").textContent = startWord;
  $("questionForm").textContent = FORM_LABELS[q.target] || q.target;

  $("answerInput").value = "";
  $("answerInput").disabled = false;
  $("checkBtn").disabled = false;

  $("feedback").className = "feedback hidden";
  $("feedback").innerHTML = "";

  answered = false;

  setTimeout(() => $("answerInput").focus(), 50);
}

function normalizeAnswer(value){
  return value.trim().replace(/\s+/g,"");
}

function checkAnswer(){
  if(answered) return;

  const q = questions[current];
  const userAnswer = normalizeAnswer($("answerInput").value);
  const rightAnswer = q.verb.f[q.target];
  if(!rightAnswer){
    alert("這一題的動詞資料不完整，請先返回設定。");
    return;
  }

  if(!userAnswer){
    $("answerInput").focus();
    return;
  }

  answered = true;
  $("answerInput").disabled = true;
  $("checkBtn").disabled = true;

  if(userAnswer === rightAnswer){
    correct++;
    $("feedback").className = "feedback ok";
    $("feedback").innerHTML =
      `<strong>✓ 正確！</strong><br>${q.verb.f[q.start]} → <strong>${rightAnswer}</strong>`;
  }else{
    $("feedback").className = "feedback bad";
    $("feedback").innerHTML =
      `<strong>✗ 答錯了</strong><br>
       你的答案：${escapeHtml(userAnswer)}<br>
       正確答案：<strong>${escapeHtml(rightAnswer)}</strong><br>
       <span>${q.verb.type}</span>`;
    saveWrong({
      key: `${q.verb.v}||${q.target}`,
      verb: q.verb.v,
      type: q.verb.type,
      start: q.start,
      target: q.target,
      user: userAnswer,
      answer: rightAnswer
    });
  }

  $("currentScore").textContent = `答對 ${correct} 題`;

  setTimeout(() => {
    if(current < questions.length - 1){
      current++;
      renderQuestion();
    }else{
      finishQuiz();
    }
  }, 900);
}

function finishQuiz(){
  $("progressBar").style.width = "100%";
  $("resultTotal").textContent = questions.length;
  $("resultCorrect").textContent = correct;
  $("resultRate").textContent = `${Math.round(correct / questions.length * 100)}%`;
  updateWrongCount();
  showOnly(resultView);
}

function saveWrong(item){
  const list = getWrong();
  const existing = list.find(x => x.key === item.key);

  if(existing){
    existing.user = item.user;
    existing.answer = item.answer;
    existing.times = (existing.times || 1) + 1;
  }else{
    list.push({...item,times:1});
  }

  localStorage.setItem("verbWrongBook", JSON.stringify(list));
  updateWrongCount();
}

function getWrong(){
  try{
    return JSON.parse(localStorage.getItem("verbWrongBook") || "[]");
  }catch{
    return [];
  }
}

function updateWrongCount(){
  const n = getWrong().length;
  $("wrongCount").textContent = n ? `(${n})` : "";
}

function renderWrong(){
  const list = getWrong();
  const box = $("wrongContent");

  $("practiceWrongBtn").disabled = list.length === 0;
  $("clearWrongBtn").disabled = list.length === 0;

  if(!list.length){
    box.innerHTML = `<div class="empty">目前沒有錯題 🎉</div>`;
    return;
  }

  box.innerHTML = `
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>動詞</th>
            <th>變化</th>
            <th>你的答案</th>
            <th>正確答案</th>
          </tr>
        </thead>
        <tbody>
          ${list.map(item => `
            <tr>
              <td>
                <strong>${escapeHtml(item.verb)}</strong><br>
                <span class="badge">${escapeHtml(item.type)}</span>
              </td>
              <td>${escapeHtml(FORM_LABELS[item.target] || item.target)}</td>
              <td>${escapeHtml(item.user)}</td>
              <td><strong>${escapeHtml(item.answer)}</strong></td>
            </tr>
          `).join("")}
        </tbody>
      </table>
    </div>
  `;
}

function showWrong(){
  renderWrong();
  showOnly(wrongView);
}

function practiceWrong(){
  const list = getWrong();
  const converted = [];

  for(const item of list){
    const verb = VERBS.find(v => v.v === item.verb);
    if(verb){
      converted.push({
        verb,
        start:item.start,
        target:item.target
      });
    }
  }

  if(!converted.length){
    alert("目前錯題本裡沒有可重新練習的題目。");
    return;
  }

  startQuiz(converted);
}

function clearWrong(){
  if(!confirm("確定要清空全部錯題嗎？")) return;
  localStorage.removeItem("verbWrongBook");
  renderWrong();
  updateWrongCount();
}

function escapeHtml(value){
  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

document.querySelectorAll(".level-toggle").forEach(button => {
  button.addEventListener("click", () => {
    const level = button.dataset.level;
    const forms = FORM_GROUPS[level];

    const boxes = forms.map(form =>
      document.querySelector(`input[name="targetForm"][value="${form}"]`)
    );

    const allChecked = boxes.every(box => box && box.checked);
    boxes.forEach(box => {
      if(box) box.checked = !allChecked;
    });

    button.textContent = allChecked ? "全選" : "取消全選";
  });
});

$("startBtn").addEventListener("click", () => startQuiz());
$("checkBtn").addEventListener("click", checkAnswer);

$("answerInput").addEventListener("keydown", event => {
  if(event.key === "Enter") checkAnswer();
});

$("quitBtn").addEventListener("click", () => {
  showOnly(setupView);
});

$("wrongBookBtn").addEventListener("click", showWrong);
$("resultWrongBtn").addEventListener("click", showWrong);
$("wrongBackBtn").addEventListener("click", () => showOnly(setupView));
$("resultBackBtn").addEventListener("click", () => showOnly(setupView));

$("againBtn").addEventListener("click", () => {
  const selected = document.querySelector('input[name="startForm"][value="' + lastStart + '"]');
  if(selected) selected.checked = true;

  document.querySelectorAll('input[name="targetForm"]').forEach(el => {
    el.checked = lastForms.includes(el.value);
  });

  startQuiz();
});

$("practiceWrongBtn").addEventListener("click", practiceWrong);
$("clearWrongBtn").addEventListener("click", clearWrong);

renderFormOptions();
updateWrongCount();
</script>
</body>
</html>
